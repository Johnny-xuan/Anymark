{
  "manifest_version": 3,
  "name": "AnyMark — Bookmark Filesystem",
  "version": "2.0.1",
  "description": "Expose Chrome bookmarks as a local filesystem interface for your agents.",
  "minimum_chrome_version": "134",
  "key": "",
  "permissions": ["bookmarks", "storage", "nativeMessaging", "activeTab", "favicon"],
  "background": { "service_worker": "extension/background.js", "type": "module" },
  "icons": { "16": "extension/icons/16.png", "32": "extension/icons/32.png", "48": "extension/icons/48.png", "128": "extension/icons/128.png" },
  "action": { "default_popup": "extension/popup.html", "default_title": "AnyMark Inbox", "default_icon": { "16": "extension/icons/16.png", "32": "extension/icons/32.png" } },
  "options_page": "web/index.html"
}
